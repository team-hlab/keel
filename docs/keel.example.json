{
  "features": {
    "autopermit":     { "sensitiveFilePatterns": [".env*", "*.key", "*.pem", "credentials*", "*secret*"], "protectedWrites": "ask" },
    "branch-guard":   { "protected": ["main", "master", "develop"] },
    "secret-scan":    { "enabled": true },
    "session-banner": { "enabled": true }
  },
  "log": { "enabled": true, "path": "~/.keel/decisions.jsonl", "maxSizeMb": 5 }
}
